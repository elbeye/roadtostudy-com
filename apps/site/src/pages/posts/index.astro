---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { contentPath } from "../../utils/content-url";
import { getReadingTime } from "../../utils/reading-time";

// This route is unprefixed (/posts) — the site default locale is TR, and the
// vast majority of the migrated corpus is Turkish, so the page is TR-primary
// chrome. Individual entries may still carry their own locale (mixed-locale
// corpus), which is why PostCard below is given each entry's own locale
// rather than a hardcoded "tr".
const locale = "tr";

// Sort in the database rather than in JS — lets the DB use its index on published_at,
// which also makes the keyset cursor stable.
//
// Bounded, and it has to be: this page is linked site-wide and the collection holds
// thousands of published posts, so the previous unlimited query loaded the whole table
// into a Worker. An unbounded render also exceeds the Worker CPU limit (Cloudflare 1102);
// 24 image cards keeps it well under budget. Cursor pagination rather than a hard cap, so
// the rest of the corpus is still reachable instead of silently truncated.
const POSTS_PAGE_LIMIT = 24;
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const { entries: posts, nextCursor, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: POSTS_PAGE_LIMIT,
	cursor,
});
// A garbage or stale cursor yields no entries rather than an error, so the page still
// renders 200 with the empty state instead of 500ing on a shared link.
const olderHref = nextCursor ? `/posts?cursor=${encodeURIComponent(nextCursor)}` : null;
const isFirstPage = !cursor;

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags across all posts, instead of one
// getEntryTerms() call per post (which would be N round-trips).
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
---

<Base title="Tüm Yazılar" description="Tüm blog yazılarına göz atın">
	<div class="posts-page">
		<header class="page-header">
			<h1 class="page-title">Tüm Yazılar</h1>
			<p class="page-description">
				{isFirstPage ? `Son ${posts.length} yazı` : `${posts.length} yazı`}
			</p>
		</header>

		{
			posts.length === 0 ? (
				<p class="empty">Henüz yazı yok.</p>
			) : (
				<div class="posts-grid">
					{posts.map((post) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={contentPath((post.data as any).locale || locale, post.data.slug || post.id)}
							date={post.data.wp_published_at ?? post.data.publishedAt ?? undefined}
							locale={(post.data as any).locale || locale}
							readingTime={getReadingTime(post.data.content)}
							tags={tagsByEntry.get(post.data.id)}
						/>
					))}
				</div>
			)
		}

		{
			(olderHref || !isFirstPage) && (
				<nav class="posts-pagination" aria-label="Yazı sayfaları">
					{/* Keyset pagination only walks forward, so "newer" returns to page 1
					    rather than stepping back one page. */}
					{!isFirstPage ? <a href="/posts">← En yeniler</a> : <span class="pagination-spacer" />}
					{olderHref ? <a href={olderHref}>Daha eski →</a> : <span class="pagination-spacer" />}
				</nav>
			)
		}
	</div>
</Base>

<style>
	.posts-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-10) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-10);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.page-title {
		font-size: var(--font-size-4xl);
		font-weight: 700;
		letter-spacing: 0;
		margin-bottom: var(--spacing-2);
	}

	.page-description {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
	}

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-10) var(--spacing-8);
	}

	.posts-pagination {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--spacing-4);
		margin-top: var(--spacing-12);
		padding-top: var(--spacing-8);
		border-top: 1px solid var(--color-border-subtle);
	}

	.posts-pagination a {
		color: var(--color-text);
		font-size: var(--font-size-sm);
		text-decoration: none;
	}

	.posts-pagination a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	/* Holds the slot so a single link stays on its own side of the row. */
	.pagination-spacer {
		display: block;
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-page {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.page-header {
			padding-bottom: var(--spacing-5);
			margin-bottom: var(--spacing-8);
		}

		.page-title {
			font-size: var(--font-size-3xl);
		}

		.posts-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-8);
		}
	}
</style>
