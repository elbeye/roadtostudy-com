# EmDash / Cloudflare
EMDASH_ENCRYPTION_KEY=
# Used by `npm run deploy` (wrangler) and the R2 media upload. In Claude Code on the web,
# set this on the ENVIRONMENT rather than in this file — a container's filesystem is
# discarded when the session ends, so a local .env has to be recreated every time.
CLOUDFLARE_API_TOKEN=

# Edge route cache purge (astro.config.mjs → experimental.cache). Optional: without these
# a published edit only goes stale on the TTL (60s), which is why the TTL is short. Set
# them as WORKER SECRETS (`wrangler secret put`), not just locally, and maxAge can go up.
CF_ZONE_ID=
CF_CACHE_PURGE_TOKEN=

# WordPress REST API extraction (scripts/wp-export-sample.mjs)
WP_BASE_URL=https://roadtostudy.com
WP_USERNAME=
WP_APPLICATION_PASSWORD=

# Media upload (scripts/wp-media-to-r2.mjs) uploads via `wrangler r2 object put`,
# which authenticates with CLOUDFLARE_API_TOKEN above — no separate R2 S3 keys needed.
# Only the bucket name is configurable (defaults to the value below).
R2_BUCKET=roadtostudy-emdash-media-poc
